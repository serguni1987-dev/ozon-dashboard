# Пример файла app\.env. Скопируйте в app\.env и подставьте свои значения
# (install.ps1 делает это сам). Файл app\.env в репозиторий не попадает.

# Кабинет Ozon Seller -> Настройки -> Seller API
OZON_CLIENT_ID=123456
OZON_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID Google-таблицы: часть ссылки между /d/ и /edit
PULT_SHEET_ID=

# Необязательно:
# PULT_COSTS_CSV=D:\data\costs_all.csv     файл себестоимости (по умолчанию costs_all.csv в папке проекта)
# PULT_AI_MODEL=qwen2.5:3b-instruct         модель Ollama для сводки
# OZON_PERF_CLIENT_ID=                      Performance API (реклама)
# OZON_PERF_CLIENT_SECRET=
